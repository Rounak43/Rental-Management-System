{
  "name": "rental-management-system-server",
  "version": "1.0.0",
  "description": "Backend API for Rental Management System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seedAll.js",
    "seed:all": "node seedAll.js",
    "seed:users": "node -e \"import('mongoose').then(m=>m.connect(process.env.MONGODB_URI||'mongodb://localhost:27017/rental-system')).then(()=>import('./seeders/seedUsers.js')).then(m=>m.seedUsers()).then(()=>process.exit())\"",
    "seed:products": "node -e \"import('mongoose').then(m=>m.connect(process.env.MONGODB_URI||'mongodb://localhost:27017/rental-system')).then(()=>import('./seeders/seedProducts.js')).then(m=>m.seedProducts()).then(()=>process.exit())\"",
    "seed:orders": "node -e \"import('mongoose').then(m=>m.connect(process.env.MONGODB_URI||'mongodb://localhost:27017/rental-system')).then(()=>import('./seeders/seedOrders.js')).then(m=>m.seedOrders()).then(()=>process.exit())\"",
    "seed:analytics": "node seedAll.js"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "author": "",
  "license": "ISC"
}
